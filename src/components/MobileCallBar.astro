---
/** Barre d'action fixe en bas d'écran, mobile uniquement : le trafic Instagram / Google Maps arrive ici. */
import { t, href, type Lang } from '../i18n/ui';
import { infos, telHref } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
---
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-laiton/30 bg-noir/95 backdrop-blur md:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
  <a href={telHref} class="flex h-16 items-center justify-center gap-2.5 bg-laiton text-[0.78rem] uppercase tracking-[0.16em] text-noir" data-track="tel-sticky">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    {u.call}<span class="sr-only"> {infos.telephone}</span>
  </a>
  {infos.reservationUrl ? (
    <a href={infos.reservationUrl} class="flex h-16 items-center justify-center text-[0.78rem] uppercase tracking-[0.16em] text-ivoire" rel="noopener">{u.bookOnline}</a>
  ) : (
    <a href={href('events', lang) + '#devis'} class="flex h-16 items-center justify-center text-[0.78rem] uppercase tracking-[0.16em] text-ivoire">{u.privatise}</a>
  )}
</div>
