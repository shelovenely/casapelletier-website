---
import Base from '../../layouts/Base.astro';
import type { Lang, RouteKey } from '../../i18n/ui';
interface Props { lang: Lang; route: RouteKey; title: string; description: string; h1: string; updated: string }
const { lang, route, title, description, h1, updated } = Astro.props;
---
<Base lang={lang} route={route} title={title} description={description}>
  <div class="paper pt-36 pb-24 md:pt-44 md:pb-32">
    <div class="wrap">
      <p class="eyebrow">Casa Pelletier</p>
      <h1 class="mt-4 font-serif text-5xl sm:text-6xl">{h1}</h1>
      <p class="mt-3 text-sm text-tabac">{updated}</p>
      <div class="prose-legal mt-12">
        <slot />
      </div>
    </div>
  </div>
</Base>
