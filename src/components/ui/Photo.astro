---
import { Picture } from 'astro:assets';
import { img } from '../../lib/images';
interface Props {
  src: string; // nom de fichier dans src/assets/images
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  imgClass?: string;
  eager?: boolean;
}
const { src, alt, sizes = '(min-width: 1024px) 50vw, 100vw', widths = [480, 768, 1080, 1440, 1920], class: cls = '', imgClass = '', eager = false } = Astro.props;
const image = img(src);
---
<Picture
  src={image}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths.filter((w) => w <= image.width)}
  sizes={sizes}
  quality={72}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding={eager ? 'sync' : 'async'}
  pictureAttributes={{ class: cls }}
  class:list={['h-full w-full object-cover', imgClass]}
/>
