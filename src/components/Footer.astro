---
import Logo from './Logo.astro';
import HoursList from './HoursList.astro';
import { NAV, t, href, type Lang } from '../i18n/ui';
import { infos, telHref, instagramUrl, pick } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
const year = new Date().getFullYear();
---
<footer class="border-t border-laiton/25 bg-vert-deep text-ivoire">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Logo />
      <p class="mt-6 max-w-xs text-sm text-ivoire-mute">{u.tagline}</p>
      <a href={instagramUrl} class="mt-6 inline-flex items-center gap-2 text-sm text-ivoire hover:text-laiton" rel="noopener" target="_blank">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
        @{infos.instagram}<span class="sr-only"> (Instagram, {lang === 'fr' ? 'nouvel onglet' : 'new tab'})</span>
      </a>
    </div>

    <div class="text-sm md:col-span-3">
      <h2 class="eyebrow mb-4">{u.address}</h2>
      <address class="not-italic leading-relaxed text-ivoire-mute">
        {infos.adresse.rue}<br />{infos.adresse.codePostal} {infos.adresse.ville}<br />
        {u.metro} 13 · {infos.metro.map((m) => m.station).join(' / ')}
      </address>
      <p class="mt-4"><a href={telHref} class="text-lg text-ivoire hover:text-laiton">{infos.telephone}</a></p>
      {infos.email && <p class="mt-1"><a href={`mailto:${infos.email}`} class="text-ivoire-mute hover:text-laiton">{infos.email}</a></p>}
    </div>

    <div class="text-sm md:col-span-3">
      <h2 class="eyebrow mb-4">{u.hours}</h2>
      <HoursList lang={lang} compact class="text-ivoire-mute" />
      <p class="mt-3 text-xs text-ivoire-mute">{pick(infos, 'noteHoraires', lang)}</p>
    </div>

    <nav class="text-sm md:col-span-2" aria-label={lang === 'fr' ? 'Plan du site' : 'Site map'}>
      <h2 class="eyebrow mb-4">Casa</h2>
      <ul class="space-y-2">
        {NAV.map((k) => <li><a href={href(k, lang)} class="text-ivoire-mute hover:text-ivoire">{u.nav[k]}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="border-t border-ivoire/10">
    <div class="wrap space-y-3 py-6 text-xs text-ivoire-mute">
      <p class="text-ivoire/80">{u.alcohol}</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} Casa Pelletier</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          <li><a href={href('legal', lang)} class="hover:text-ivoire">{u.nav.legal}</a></li>
          <li><a href={href('privacy', lang)} class="hover:text-ivoire">{u.nav.privacy}</a></li>
          <li><a href={href('cookies', lang)} class="hover:text-ivoire">{u.nav.cookies}</a></li>
          <li><button type="button" class="cursor-pointer hover:text-ivoire" data-cookie-open>{u.cookiesManage}</button></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
