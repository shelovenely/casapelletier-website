---
interface Props { eyebrow?: string; title: string; num?: string; align?: 'left' | 'center'; as?: 'h1' | 'h2'; class?: string }
const { eyebrow, title, num, align = 'left', as: Tag = 'h2', class: cls = '' } = Astro.props;
---
<div class:list={[align === 'center' ? 'mx-auto text-center' : '', 'max-w-3xl', cls]} data-reveal>
  {eyebrow && (
    <p class:list={['eyebrow mb-5 flex items-center gap-3', align === 'center' && 'justify-center']}>
      {num && <span class="font-serif text-base tracking-normal normal-case italic">{num}</span>}
      {num && <span aria-hidden="true" class="h-px w-8 bg-current opacity-60"></span>}
      {eyebrow}
    </p>
  )}
  <Tag class="h-section" set:html={title} />
  <slot />
</div>
